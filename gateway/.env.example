# Demo Gateway — environment variable template
# Copy to .env and fill in values before running against real services
# NEVER commit .env to source control

# Server
PORT=3001
NODE_ENV=development

# ─── Module 1: Fulfillment Prediction (IRIS) ─────────────────────────────────
# REST base URL for the fulfillment-prediction/IRIS service
# Ask Engineering: which environment? (staging preferred for demo traffic)
QUALIFY_SERVICE_URL=https://fulfillment-prediction.staging.dmgenv.com

# Service account bearer token for IRIS
# Ask Engineering: provision a demo service account with qualification ACLs
QUALIFY_API_KEY=

# ─── Module 2: Matching Engine + GDA/Cipher ──────────────────────────────────
# REST base URL for the matching engine
MATCH_SERVICE_URL=https://matching-engine.staging.dmgenv.com

# GDA/Cipher service URL (returns AI rationale + ranked recommendations)
GDA_SERVICE_URL=https://cipher.staging.dmgenv.com

# Credentials for matching/GDA (may share the same service account)
MATCH_API_KEY=

# Demo property IDs — Engineering must provision these in staging
# These must correspond to real properties with plumbing/HVAC coverage
DEMO_PROPERTY_ID_HWH=DEMO_HEARTLAND_BLOOMINGTON_IL
DEMO_PROPERTY_ID_HVAC=DEMO_WALGREENS_AUSTIN_TX
DEMO_PROPERTY_ID_CEILING=DEMO_DOLLAR_GENERAL_MEMPHIS_TN

# ─── Module 3: Work Verification API (Hawk-Eye) ───────────────────────────────
# REST base URL for the work-verification-api
VERIFY_SERVICE_URL=https://work-verification-api.staging.dmgenv.com

# Service account bearer token for Hawk-Eye
VERIFY_API_KEY=

# Pre-seeded demo work IDs — Engineering must create and maintain these
# Each work_id must have real visit photos uploaded in staging
DEMO_WV_WORK_ID_HWH=DEMO_WV_PLUMBING_WATER_HEATER_01
DEMO_WV_WORK_ID_HVAC=DEMO_WV_HVAC_NOT_COOLING_01
DEMO_WV_WORK_ID_CEILING=DEMO_WV_CEILING_TILE_01

# ─── Timeouts ─────────────────────────────────────────────────────────────────
# Request timeout in milliseconds for each service
# IRIS and Hawk-Eye call GPT-4 — allow generous timeouts for live AI calls
QUALIFY_TIMEOUT_MS=45000
MATCH_TIMEOUT_MS=30000
VERIFY_START_TIMEOUT_MS=15000
VERIFY_POLL_TIMEOUT_MS=10000

# Max seconds to wait for Hawk-Eye to complete before returning 504
VERIFY_MAX_WAIT_MS=90000
